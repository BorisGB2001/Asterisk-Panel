# boris.gb 2026-10-31 15:05 - HTTPS for Asterisk-Panel. Generated by install.sh from Caddyfile.in (__HOST__, __PORT__, __TLS__).
# __TLS__ = "internal": certificate from Caddy's own CA (private address, no Let's Encrypt). To trust it, import
# /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt on the workstations.
{
	admin off
	auto_https disable_redirects
	# browsers send no SNI when the panel is opened by IP — use the certificate for this host anyway
	default_sni __HOST__
}

https://__HOST__:__PORT__ {
	tls __TLS__

	encode gzip
	reverse_proxy 127.0.0.1:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; media-src 'self'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}
}
